# Copy this file to .env.test and fill in your API keys.
# .env.test is gitignored — never commit real keys.

# https://openweathermap.org/api — free tier works fine
OPENWEATHER_API_KEY=your_openweather_api_key_here

# https://www.weatherapi.com — free tier works fine
WEATHERAPI_KEY=your_weatherapi_key_here

# Open-Meteo needs no key — no entry required
