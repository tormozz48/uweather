{
  "name": "uweather",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "AWS_PROFILE=uweather pnpm sst dev",
    "build": "tsc --build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "typecheck": "tsc --build",
    "deploy-dev": "AWS_PROFILE=uweather pnpm sst deploy --stage dev",
    "deploy-prod": "AWS_PROFILE=uweather pnpm sst deploy --stage prod",
    "deploy-prod-first": "FIRST_PROD_DEPLOY=FIRST_DEPLOY AWS_PROFILE=uweather pnpm sst deploy --stage prod",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "husky": "^9.1.7",
    "@biomejs/cli-linux-arm64": "^1.9.4",
    "@types/node": "^25.6.2",
    "sst": "^3.5.0",
    "typescript": "^5.6.0"
  }
}
